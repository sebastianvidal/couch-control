<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Couchpad</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Couchpad finds and controls your Mac over your local Wi-Fi.</string>
	<key>NSCameraUsageDescription</key>
	<string>Couchpad uses the camera only to scan the pairing QR code shown on your computer.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.seb.CouchControl.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>couchctl</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBonjourServices</key>
	<array>
		<string>_couchctl._tcp</string>
	</array>
</dict>
</plist>
